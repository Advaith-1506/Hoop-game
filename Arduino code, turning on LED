unsigned long previousMillis = 0;
const long interval = 100;  // 100 ms interval

void setup() {
  Serial.begin(9600);

  pinMode(10, INPUT_PULLUP);  // Sensor 1
  pinMode(11, INPUT_PULLUP);  // Sensor 2
  pinMode(13, OUTPUT);       // LED
}

void loop() {
  int val1 = digitalRead(10);
  int val2 = digitalRead(11);

  if (val1 == 0 || val2 == 0) {
    digitalWrite(13, LOW);
  }
  else {
    digitalWrite(13, HIGH);
  }

  unsigned long currentMillis = millis();

  if (currentMillis - previousMillis >= interval) {
    previousMillis = currentMillis;

    Serial.print("The value of sensor 1 is: ");
    Serial.println(val1);

    Serial.print("The value of sensor 2 is: ");
    Serial.println(val2);
  }
}
